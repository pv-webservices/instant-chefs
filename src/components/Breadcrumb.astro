---
interface Props {
  title: string;
  parent?: { title: string; href: string };
}
const { title, parent } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href="/">Home</a>
    </li>
    {parent && (
      <li>
        <a href={parent.href}>{parent.title}</a>
      </li>
    )}
    <li aria-current="page">{title}</li>
  </ol>
</nav>
