---
import { getResponsiveImage } from '../data/images';
interface Props {
  name: string;
  alt: string;
  class?: string;
  /** Above-the-fold image: load immediately. */
  eager?: boolean;
  /** The page's LCP image: load immediately with high fetch priority. */
  priority?: boolean;
  sizes?: string;
}
const {
  name,
  alt,
  class: className = '',
  eager = false,
  priority = false,
  sizes = '(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 33vw',
} = Astro.props;
const image = getResponsiveImage(name);
const loadNow = eager || priority;
---

<img
  class={className || undefined}
  src={image.src}
  srcset={image.srcset}
  sizes={sizes}
  alt={alt}
  width={image.width}
  height={image.height}
  loading={loadNow ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding={priority ? 'sync' : 'async'}
/>
