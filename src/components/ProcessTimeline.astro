---
import { process } from '../data/business';
import Icon from './Icon.astro';
---

<ol class="ic-steps" data-reveal="steps">
  {process.map((step, index) => (
    <li class="ic-step" style={`--i:${index}`}>
      <span class="ic-step-icon">
        <Icon name={step.icon} size={30} />
        <span class="ic-step-num">{index + 1}</span>
      </span>
      <h3>{step.title}</h3>
      <p>{step.text}</p>
    </li>
  ))}
</ol>
