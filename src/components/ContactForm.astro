---
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { services, cuisines, business, plans } from '../data/business';
import { LIMITS } from '../scripts/form-validation';

const FORM_ENDPOINT = `https://formsubmit.co/${business.email}`;
// Redirect to our own Thank You page only when the real production origin is
// known; otherwise FormSubmit shows its default confirmation page.
const thankYouUrl = __SITE_INDEXABLE__
  ? new URL('/thank-you/', Astro.site).href
  : undefined;
const planLabel = (plan: (typeof plans)[number]) =>
  `${plan.name} · ${plan.months} months · ₹${plan.fee.toLocaleString('en-IN')}`;
---

<div class="contact-card">
  <h2>Tell us about your kitchen.</h2>
  <p>
    Send your requirement straight to our team. Fields marked
    <span aria-hidden="true">*</span>
    <span class="sr-only">required</span> are required.
  </p>
  <form
    id="enquiry-form"
    class="enquiry-form"
    action={FORM_ENDPOINT}
    method="POST"
    accept-charset="UTF-8"
  >
    <input
      type="hidden"
      name="_subject"
      value="New Website Enquiry - Instant Chefs"
    />
    <input type="hidden" name="_template" value="table" />
    {thankYouUrl && <input type="hidden" name="_next" value={thankYouUrl} />}
    <div class="form-honeypot" aria-hidden="true">
      <label for="website-field">Leave this field empty</label>
      <input
        id="website-field"
        type="text"
        name="_honey"
        tabindex="-1"
        autocomplete="off"
        style="display:none"
      />
    </div>
    <p id="form-summary" class="form-summary" role="alert" hidden></p>
    <div class="form-grid">
      <div class="field">
        <label for="full-name">
          Name{' '}
          <span class="required-mark" aria-hidden="true">
            *
          </span>
        </label>
        <input
          id="full-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          minlength={LIMITS.nameMin}
          maxlength={LIMITS.nameMax}
          aria-describedby="full-name-error"
          data-validate="name"
        />
        <p class="field-error" id="full-name-error" hidden></p>
      </div>
      <div class="field">
        <label for="email-address">
          Email{' '}
          <span class="required-mark" aria-hidden="true">
            *
          </span>
        </label>
        <input
          id="email-address"
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength={LIMITS.emailMax}
          aria-describedby="email-address-error"
          data-validate="email"
        />
        <p class="field-error" id="email-address-error" hidden></p>
      </div>
      <div class="field">
        <label for="mobile-number">
          Phone{' '}
          <span class="required-mark" aria-hidden="true">
            *
          </span>
        </label>
        <input
          id="mobile-number"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          required
          pattern="\+?[0-9\s\(\)\-]{10,20}"
          maxlength={LIMITS.phoneMax}
          aria-describedby="mobile-number-hint mobile-number-error"
          data-validate="phone"
        />
        <p class="field-hint" id="mobile-number-hint">
          10–15 digits, e.g. +91 84484 96343
        </p>
        <p class="field-error" id="mobile-number-error" hidden></p>
      </div>
      <div class="field">
        <label for="location">Kitchen / home location</label>
        <input
          id="location"
          name="location"
          autocomplete="address-level2"
          maxlength="120"
          placeholder="City and area"
        />
      </div>
      <div class="field">
        <label for="business-type">Business / household type</label>
        <select id="business-type" name="business_type">
          <option value="">Select your kitchen</option>
          {services.map((service) => (
            <option value={service.name}>{service.name}</option>
          ))}
          <option>Other requirement</option>
        </select>
      </div>
      <div class="field">
        <label for="staff-requirement">Staff requirement</label>
        <select id="staff-requirement" name="staff_requirement">
          <option value="">Who are you looking for?</option>
          <option>Chef</option>
          <option>Bakery staff</option>
          <option>Full-time live-in home cook</option>
          <option>Maid</option>
          <option>Gardener</option>
          <option>Other — discuss with team</option>
        </select>
      </div>
      <div class="field">
        <label for="cuisine">Cuisine requirement</label>
        <select id="cuisine" name="cuisine">
          <option value="">Select a cuisine, if relevant</option>
          {cuisines.map((cuisine) => (
            <option>{cuisine.name}</option>
          ))}
          <option>Multiple cuisines</option>
          <option>Other — discuss with team</option>
          <option>Not applicable</option>
        </select>
      </div>
      <div class="field">
        <label for="selected-plan">Hiring plan</label>
        <select id="selected-plan" name="plan">
          <option value="">Help me choose a plan</option>
          {plans.map((plan) => (
            <option value={planLabel(plan)} data-plan={plan.id}>
              {planLabel(plan)}
            </option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="experience">Experience requirement</label>
        <input
          id="experience"
          name="experience"
          maxlength="100"
          placeholder="e.g. 3 years in a restaurant"
        />
      </div>
      <div class="field">
        <label for="salary">Preferred salary range</label>
        <input
          id="salary"
          name="salary_range"
          maxlength="80"
          placeholder="e.g. ₹20,000–₹25,000 per month"
        />
      </div>
      <div class="field field-full">
        <label for="message">
          Message{' '}
          <span class="required-mark" aria-hidden="true">
            *
          </span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          minlength={LIMITS.messageMin}
          maxlength={LIMITS.messageMax}
          aria-describedby="message-hint message-error"
          data-validate="message"
          placeholder="Your menu, schedule or anything that matters to your hire."
        ></textarea>
        <p class="field-hint" id="message-hint">
          At least {LIMITS.messageMin} characters.
        </p>
        <p class="field-error" id="message-error" hidden></p>
      </div>
      <div class="field field-full field-check">
        <div class="check-row">
          <input
            id="consent"
            name="consent"
            type="checkbox"
            value="Agreed to the privacy policy"
            required
            aria-describedby="consent-error"
            data-validate="consent"
          />
          <label for="consent">
            I agree to the <a href="/privacy-policy/">privacy policy</a> and
            consent to Instant Chefs using these details to respond to my
            enquiry.{' '}
            <span class="required-mark" aria-hidden="true">
              *
            </span>
          </label>
        </div>
        <p class="field-error" id="consent-error" hidden></p>
      </div>
    </div>
    <p class="form-help">
      Your enquiry is delivered to the Instant Chefs team by email through
      FormSubmit. Please share only information needed for your staffing
      enquiry.
    </p>
    <div class="form-actions">
      <button type="submit" class="button" id="enquiry-submit">
        <span data-label>Send enquiry</span>
        <Icon name="arrow" size={18} />
      </button>
      <button
        type="button"
        class="button button-outline"
        id="send-whatsapp"
        hidden
      >
        <WhatsAppIcon size={18} />
        Send via WhatsApp
      </button>
    </div>
    <p class="form-help">
      Prefer to talk? Call <a href={business.tel}>{business.phone}</a>.
    </p>
  </form>
</div>
<script>
  import { initEnquiryForm } from '../scripts/enquiry';
  initEnquiryForm();
</script>
