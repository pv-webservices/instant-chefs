---
import Base from '../layouts/Base.astro';
import HelpfulLinks from '../components/HelpfulLinks.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Page Not Found"
  description="This Instant Chefs page could not be found. Explore our chef and staffing services, or call, WhatsApp or contact the team."
  cta={false}
  noindex
>
  <section class="section warm-section utility-page">
    <div class="container">
      <span class="eyebrow">404 · A wrong turn, not a wrong kitchen</span>
      <h1>Let’s get you back to the good stuff.</h1>
      <p>
        This page isn’t on the menu. It may have moved, or the link may be
        mistyped. Our team is still here to help.
      </p>
      <div class="button-row">
        <a href="/" class="button">
          Back to home <Icon name="arrow" size={18} />
        </a>
        <a href="/contact/" class="button button-outline">
          Talk to our team
        </a>
      </div>
      <HelpfulLinks />
    </div>
  </section>
</Base>
