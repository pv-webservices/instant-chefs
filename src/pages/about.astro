---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Icon from '../components/Icon.astro';
import { features } from '../data/business';
---

<Base
  title="About Us — Good People, Great Kitchens"
  description="Meet Instant Chefs, a Faridabad-based chef and staffing service helping businesses and households find the right people with verification, trials and support."
>
  <PageHero
    label="About Instant Chefs"
    title="Behind every great kitchen, there are great people."
    text="We help you find them. A thoughtful, personal approach to chef hiring for food businesses and homes."
    image="team"
    imageAlt="Team of smiling chefs and kitchen staff in a professional kitchen"
    cta="Let’s talk about your kitchen"
  />
  <section class="section">
    <div class="container split-content">
      <SectionHeading
        label="OUR STORY IS ABOUT YOUR KITCHEN"
        title="You focus on the food. We focus on the fit."
      />
      <div class="prose" data-reveal>
        <p>
          Instant Chefs is a chef and staffing service based in Faridabad,
          Haryana. We work with restaurants, cafés, cloud kitchens, bakeries,
          long-term catering businesses and households looking for a full-time
          live-in cook.
        </p>
        <p>
          Hiring should feel like a conversation, not a complication. We begin
          with your requirements: the role, the cuisine, the experience and the
          salary range. Then we help you meet suitable candidates, arrange a
          practical trial and make a choice you feel comfortable with.
        </p>
        <p>
          Our work continues after the introduction. With ongoing support and
          free chef replacements within your selected plan, you have someone to
          call when your kitchen needs a helping hand.
        </p>
      </div>
    </div>
  </section>
  <section class="section warm-section">
    <div class="container">
      <SectionHeading
        label="A LITTLE MORE CARE AT EVERY STEP"
        title="A hiring approach built around you."
        centered
      />
      <div class="detail-grid">
        <article class="detail-card" data-reveal>
          <Icon name="shield" size={32} />
          <h3>Meet verified candidates</h3>
          <p>
            Every chef goes through a background check, skill test and
            interview. We match the shortlist to your cuisine and experience
            requirements.
          </p>
        </article>
        <article class="detail-card" data-reveal>
          <Icon name="utensils" size={32} />
          <h3>Make your own choice</h3>
          <p>
            Interview candidates directly, then choose a chef for a one-day
            trial. You can try up to five chefs before making your final
            decision.
          </p>
        </article>
        <article class="detail-card" data-reveal>
          <Icon name="headphones" size={32} />
          <h3>Keep support close</h3>
          <p>
            Our team offers 24/7 real-time support and helps coordinate chef
            replacements within the duration of your hiring plan.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-top">
        <SectionHeading
          label="FOR BUSINESS. FOR HOME."
          title="Many kitchens. One personal approach."
          text="The needs are different. The care we bring to the search stays the same."
        />
        <a class="text-link" href="/services/">
          Explore our services <Icon name="arrow" size={18} />
        </a>
      </div>
      <ServicesGrid />
    </div>
  </section>
  <section class="section process-section">
    <div class="container split-content">
      <SectionHeading
        label="SKILLS THAT FIT THE FOOD"
        title="From familiar favourites to your signature dishes."
        text="Our listed cuisine expertise covers Indian, Chinese, Tandoor, Bakery, Continental and South Indian. Share your menu with us to find the right match."
      />
      <div>
        <ul class="check-list">
          {features.map((feature) => (
            <li>
              <Icon name="check" size={20} />
              <span>
                {feature.title}
                <p style="font-size:12px;margin-top:5px">{feature.text}</p>
              </span>
            </li>
          ))}
        </ul>
        <a class="text-link" href="/cuisines/" style="margin-top:25px">
          Discover cuisine expertise <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>
</Base>
